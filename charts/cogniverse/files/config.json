    "default_profiles": {
{{- $selected := list }}
{{- range $modality := list "video" "audio" }}
{{- with index $.Values.config.defaultProfiles $modality }}
{{- $selected = append $selected (dict "modality" $modality "profile" .) }}
{{- end }}
{{- end }}
{{- range $i, $entry := $selected }}
{{- if $i }},{{ end }}
      {{ $entry.modality | quote }}: {
        "profile": {{ $entry.profile | quote }}
      }
{{- end }}
    }
