{
  "semantic_router": {
    "response_cache_ttl_seconds": {{ int .Values.semanticRouter.router.responseCache.ttlSeconds }},
    "response_cache_max_entries": {{ int .Values.semanticRouter.router.responseCache.maxEntries }}
  },
  "harness": {
    "api_keys": {
      "$COGNIVERSE_HARNESS_API_KEY": "default"
    },
    "models": {
      "cogniverse": "gateway_agent",
      "cogniverse/search": "search_agent",
      "cogniverse/summarizer": "summarizer_agent",
      "cogniverse/deep-research": "deep_research_agent",
      "cogniverse/coding": "coding_agent"
    }
  },
{{- with .Values.config.defaultProfiles.video }}
  "active_video_profile": {{ . | quote }},
{{- end }}
  "answer_grounding_search_timeout_seconds": 12.0,
  "agents": {
    "search_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "search",
        "video_search",
        "retrieval"
      ],
      "modalities": [
        "VIDEO"
      ]
    },
    "text_analysis_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "text_analysis",
        "sentiment",
        "classification"
      ],
      "modalities": [
        "DOCUMENT"
      ]
    },
    "summarizer_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "streams_answer_tokens": true,
      "capabilities": [
        "summarization",
        "text_generation"
      ],
      "modalities": [
        "VIDEO",
        "DOCUMENT",
        "AUDIO"
      ]
    },
    "detailed_report_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "streams_answer_tokens": true,
      "capabilities": [
        "detailed_report",
        "analysis",
        "text_generation"
      ],
      "modalities": [
        "VIDEO",
        "DOCUMENT"
      ]
    },
    "image_search_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "image_search",
        "visual_analysis"
      ],
      "modalities": [
        "IMAGE"
      ]
    },
    "audio_analysis_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "audio_analysis",
        "transcription"
      ],
      "modalities": [
        "AUDIO"
      ]
    },
    "document_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "document_analysis",
        "pdf_processing"
      ],
      "modalities": [
        "DOCUMENT",
        "WIKI"
      ]
    },
    "deep_research_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "streams_answer_tokens": true,
      "capabilities": [
        "deep_research",
        "analysis"
      ],
      "modalities": [
        "VIDEO",
        "DOCUMENT"
      ]
    },
    "coding_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "coding",
        "code_generation",
        "code_search"
      ],
      "modalities": [
        "CODE"
      ]
    },
    "gateway_agent": {
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "enabled": true,
      "capabilities": [
        "gateway",
        "classification"
      ],
      "timeout": 10
    },
    "entity_extraction_agent": {
      "enabled": true,
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "capabilities": [
        "entity_extraction",
        "ner"
      ],
      "timeout": 15
    },
    "query_enhancement_agent": {
      "enabled": true,
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "capabilities": [
        "query_enhancement",
        "expansion"
      ],
      "timeout": 15
    },
    "profile_selection_agent": {
      "enabled": true,
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "capabilities": [
        "profile_selection"
      ],
      "timeout": 15
    },
    "orchestrator_agent": {
      "enabled": true,
      "url": "{{ include "cogniverse.runtimeUrl" . }}",
      "capabilities": [
        "orchestration",
        "planning",
        "multi_agent_coordination"
      ],
      "timeout": 120
    }
  },
  "llm_config": {
    "primary": {
      "model": "{{ include "cogniverse.primaryLLMModel" . }}",
      "api_key": "{{ include "cogniverse.llmPlaceholderApiKey" . }}",
      "temperature": 0.1,
      "max_tokens": 1000,
      "adapter_path": null,
      "api_base": "{{ include "cogniverse.primaryLLMEndpoint" . }}",
      "request_timeout": 210.0
    },
    "teacher": {
      "model": "{{ include "cogniverse.teacherLLMModel" . }}",
      "api_base": "{{ include "cogniverse.llmTeacherEndpoint" . }}",
      "api_key": "{{ include "cogniverse.llmPlaceholderApiKey" . }}",
      "temperature": 0.7,
      "max_tokens": 2048,
      "context_window": 4096,
      "adapter_path": null,
      "request_timeout": 210.0
    },
    "overrides": {
      "llm_auto_annotator": null
    }
  },
  "detailed_report_agent_url": "{{ include "cogniverse.runtimeUrl" . }}",
  "summarizer_agent_url": "{{ include "cogniverse.runtimeUrl" . }}",
  "orchestrator_agent_port": 8013,
  "automation_rules": {
    "annotation_thresholds": {
      "confidence_threshold": 0.6,
      "very_low_confidence": 0.3,
      "boundary_low": 0.6,
      "boundary_high": 0.75,
      "failure_lookback_hours": 24,
      "max_annotations_per_run": 50,
      "max_annotations_per_batch": 10
    },
    "optimization_triggers": {
      "min_annotations_for_optimization": 50,
      "optimization_improvement_threshold": 0.05,
      "optimization_gap_share": 0.5,
      "optimization_skip_above_score": 0.95,
      "min_days_between_optimizations": 1,
      "span_eval_lookback_hours": 2,
      "annotation_lookback_hours": 24,
      "span_eval_batch_size": 100,
      "max_annotations_per_cycle": 100
    },
    "feedback": {
      "poll_interval_minutes": 15,
      "min_annotations_for_update": 10,
      "quality_map": {
        "correct_routing": 0.9,
        "wrong_routing": 0.3,
        "ambiguous": 0.6,
        "insufficient_info": 0.5
      }
    },
    "intervals": {
      "annotation_interval_minutes": 30,
      "feedback_interval_minutes": 15
    },
    "online_evaluation": {
      "enabled": true,
      "sampling_rate": 1.0,
      "evaluators": [
        "routing_outcome",
        "confidence_calibration"
      ],
      "persist_scores": true,
      "score_annotation_name": "online_eval"
    }
  },
  "rails": {
    "enabled": true,
    "input_rails": [
      {
        "type": "content_safety",
        "params": {
          "blocked_patterns": [
            "ignore previous instructions",
            "system prompt",
            "<script>"
          ]
        }
      }
    ],
    "output_rails": []
  },
  "search_backend": "vespa",
  "colpali_model": "TomoroAI/tomoro-colqwen3-embed-4b",
  "embedding_model": "lightonai/DenseOn",
  "remote_inference_url": null,
  "evaluators": {
    "visual_judge": {
      "provider": "vllm",
      "model": "google/gemma-4-e4b-it",
      "base_url": "{{ include "cogniverse.llmStudentEndpoint" . }}",
      "api_key": null,
      "frames_per_video": 30,
      "max_videos": 2,
      "sample_all_frames": false,
      "max_total_frames": 60
    },
    "llm_judge": {
      "provider": "vllm",
      "model": "google/gemma-4-e4b-it",
      "base_url": "{{ include "cogniverse.llmStudentEndpoint" . }}",
      "api_key": null
    },
    "modal_visual_judge": {
      "provider": "modal",
      "model": "qwen2-vl",
      "base_url": "https://your-modal-endpoint.modal.run/",
      "api_key": "your-modal-api-key"
    }
  },
  "remote_inference_api_key": null,
  "pipeline_cache": {
    "enabled": true,
    "backends": [
      {
        "backend_type": "structured_filesystem",
        "base_path": "/tmp/cogniverse/structured_pipeline",
        "serialization_format": "json",
        "priority": 0,
        "enable_ttl": true,
        "cleanup_on_startup": true
      },
      {
        "backend_type": "s3",
        "bucket": "cogniverse-pipeline-cache",
        "key_prefix": "pipeline/",
        "serialization_format": "pickle",
        "priority": 1,
        "enable_ttl": true,
        "lifecycle_expiration_days": 7,
        "enabled": true
      }
    ],
    "default_ttl": 604800,
    "enable_compression": true,
    "serialization_format": "json"
  },
  "pipeline_config": {
    "extract_keyframes": true,
    "transcribe_audio": true,
    "generate_descriptions": true,
    "generate_embeddings": true,
    "keyframe_fps": 0.5
  },
  "max_workers": 4,
  "timeout": 60.0,
  "reranking": {
    "enabled": false,
    "model": "heuristic",
    "hybrid_strategy": "weighted_ensemble",
    "learned_weight": 0.7,
    "heuristic_weight": 0.3,
    "max_results_to_rerank": 100,
    "top_n": null,
    "api_base": null,
    "supported_models": {
      "cohere": "cohere/rerank-english-v3.0",
      "together_ai": "together_ai/Salesforce/Llama-Rank-V1",
      "jina": "jina/jina-reranker-v2-base-multilingual",
      "ollama_bge": "openai/bge-reranker-v2-m3",
      "ollama_mxbai": "openai/mxbai-rerank-large-v2",
      "heuristic": "heuristic"
    }
  },
  "routing": {
    "routing_mode": "tiered",
    "optimization_config": {
      "enable_auto_optimization": false,
      "optimization_interval_seconds": 3600,
      "min_samples_for_optimization": 100,
      "min_unique_queries": 3,
      "optimizer_floors": {
        "profile_selection": {
          "min_samples_for_optimization": 20,
          "min_unique_queries": 6
        },
        "entity_extraction": {
          "min_samples_for_optimization": 30,
          "min_unique_queries": 15
        }
      },
      "training_selection": {
        "simba_query_enhancement": {
          "trainset_cap": 300,
          "mmr_lambda": 0.7,
          "low_confirmation_threshold": 3,
          "downweight_age_days": 14,
          "downweight_factor": 0.5
        },
        "profile_selection": {
          "trainset_cap": 300,
          "mmr_lambda": 0.7,
          "low_confirmation_threshold": 3,
          "downweight_age_days": 14,
          "downweight_factor": 0.5
        },
        "entity_extraction": {
          "trainset_cap": 300,
          "mmr_lambda": 0.7,
          "low_confirmation_threshold": 3,
          "downweight_age_days": 14,
          "downweight_factor": 0.5,
          "confirmation_score_threshold": 0.7
        }
      }
    },
    "annotation": {
      "model": "claude-3-5-sonnet-20241022",
      "api_base": null,
      "api_key": null
    }
  },
  "synthetic": {
    "field_mappings": {
      "topic_fields": [
        "video_title",
        "audio_title",
        "image_title",
        "document_title",
        "chunk_name",
        "title"
      ],
      "description_fields": [
        "segment_description",
        "image_description",
        "full_text",
        "source_code",
        "content",
        "description"
      ],
      "transcript_fields": [
        "audio_transcript",
        "transcript"
      ],
      "entity_fields": [
        "video_title",
        "segment_description"
      ],
      "temporal_fields": {
        "start": "start_time",
        "end": "end_time"
      },
      "metadata_fields": {}
    },
    "synthetic_generation_timeout_seconds": 300.0,
    "synthetic_generation_floor_count": 1,
    "optimizer_configs": {
      "modality": {
        "optimizer_type": "modality",
        "agent_mappings": [
          {
            "modality": "VIDEO",
            "agent_name": "search_agent"
          },
          {
            "modality": "DOCUMENT",
            "agent_name": "document_agent"
          },
          {
            "modality": "IMAGE",
            "agent_name": "image_search_agent"
          },
          {
            "modality": "AUDIO",
            "agent_name": "audio_analysis_agent"
          },
          {
            "modality": "CODE",
            "agent_name": "coding_agent"
          },
          {
            "modality": "WIKI",
            "agent_name": "document_agent"
          }
        ]
      },
      "cross_modal": {
        "optimizer_type": "cross_modal",
        "profile_scoring_rules": [
          {
            "condition": {"field": "embedding_type", "contains": "multi_vector"},
            "score_adjustment": 2.0,
            "reason": "multi-vector fusion capability"
          },
          {
            "condition": {"field": "pipeline_config.transcribe_audio", "equals": true},
            "score_adjustment": 1.5,
            "reason": "audio transcription"
          }
        ]
      },
      "entity_extraction": {
        "optimizer_type": "entity_extraction",
        "profile_scoring_rules": [
          {
            "condition": {"field": "pipeline_config.generate_descriptions", "equals": true},
            "score_adjustment": 2.0,
            "reason": "rich descriptions"
          },
          {
            "condition": {"field": "pipeline_config.transcribe_audio", "equals": true},
            "score_adjustment": 1.0,
            "reason": "text content"
          }
        ]
      },
      "profile": {
        "optimizer_type": "profile",
        "profile_scoring_rules": [
          {
            "condition": {"profile_name_contains": "colpali"},
            "score_adjustment": 0.5,
            "reason": "ColPali model"
          },
          {
            "condition": {"profile_name_contains": "colqwen"},
            "score_adjustment": 0.5,
            "reason": "ColQwen model"
          }
        ]
      },
      "query_enhancement": {
        "optimizer_type": "query_enhancement",
        "profile_scoring_rules": [
          {
            "condition": {"field": "pipeline_config.generate_descriptions", "equals": true},
            "score_adjustment": 2.0,
            "reason": "rich descriptions"
          },
          {
            "condition": {"field": "pipeline_config.transcribe_audio", "equals": true},
            "score_adjustment": 1.0,
            "reason": "text content"
          }
        ]
      },
      "routing": {
        "optimizer_type": "routing",
        "dspy_modules": {
          "query_generator": {
            "signature_class": "cogniverse_synthetic.dspy_signatures.GenerateEntityQuery",
            "module_type": "ChainOfThought",
            "lm_config": {},
            "metadata": {}
          }
        },
        "profile_scoring_rules": [
          {
            "condition": {"field": "pipeline_config.generate_descriptions", "equals": true},
            "score_adjustment": 2.0,
            "reason": "rich descriptions"
          },
          {
            "condition": {"field": "pipeline_config.transcribe_audio", "equals": true},
            "score_adjustment": 1.0,
            "reason": "text content"
          },
          {
            "condition": {"profile_name_contains": "colpali"},
            "score_adjustment": 0.5,
            "reason": "ColPali model"
          }
        ]
      },
      "unified": {
        "optimizer_type": "unified",
        "profile_scoring_rules": [
          {
            "condition": {"field": "embedding_type", "contains": "multi_vector"},
            "score_adjustment": 2.0,
            "reason": "multi-vector retrieval"
          },
          {
            "condition": {"field": "pipeline_config.generate_descriptions", "equals": true},
            "score_adjustment": 1.0,
            "reason": "rich descriptions"
          }
        ]
      },
      "workflow": {
        "optimizer_type": "workflow",
        "profile_scoring_rules": [
          {
            "condition": {"profile_name_contains": "chunk"},
            "score_adjustment": 1.5,
            "reason": "temporal chunking"
          },
          {
            "condition": {"field": "type", "equals": "document"},
            "score_adjustment": 1.25,
            "reason": "text-bearing document corpus"
          },
          {
            "condition": {"profile_name_contains": "frame"},
            "score_adjustment": 1.0,
            "reason": "frame-level detail"
          }
        ]
      }
    }
  },
  "backend": {
    "type": "vespa",
    "url": "{{ include "cogniverse.vespaUrl" . }}",
    "port": 8080,
    "profiles": {
      "video_colpali_smol500_mv_frame": {
        "type": "video",
        "description": "Frame-based ColPali for patch-level visual search with multi-vector embeddings. Extracts keyframes and generates 320-dim patch embeddings for fine-grained matching.",
        "schema_name": "video_colpali_smol500_mv_frame",
        "result_granularity": "source",
        "embedding_model": "TomoroAI/tomoro-colqwen3-embed-4b",
        "model_config": {
          "token_pool_factor": 1
        },
        "pipeline_config": {
          "extract_keyframes": true,
          "transcribe_audio": true,
          "generate_descriptions": true,
          "generate_embeddings": true,
          "keyframe_strategy": "fps",
          "keyframe_fps": 0.5
        },
        "strategies": {
          "segmentation": {
            "class": "FrameSegmentationStrategy",
            "params": {
              "fps": 0.5,
              "threshold": 0.999,
              "max_frames": 3000
            }
          },
          "transcription": {
            "class": "AudioTranscriptionStrategy",
            "params": {
              "model": "openai/whisper-large-v3-turbo"
            }
          },
          "description": {
            "class": "VLMDescriptionStrategy",
            "params": {
              "vlm_endpoint": "{{ include "cogniverse.llmStudentEndpoint" . }}",
              "batch_size": 500,
              "timeout": 10800
            }
          },
          "embedding": {
            "class": "MultiVectorEmbeddingStrategy",
            "params": {}
          }
        },
        "embedding_type": "multi_vector",
        "model_loader": "colpali",
        "inference_services": {
          "embedding": "vllm_colpali",
          "transcription": "vllm_asr"
        },
        "schema_config": {
          "schema_name": "video_colpali_smol500_mv_frame",
          "model_name": "ColQwen3",
          "num_patches": 1024,
          "embedding_dim": 320,
          "binary_dim": 40
        }
      },
      "image_colpali_mv": {
        "type": "image",
        "description": "ColPali multi-vector embeddings for image search. Loads images directly and generates 320-dim patch embeddings for fine-grained visual matching.",
        "schema_name": "image_colpali_mv",
        "embedding_model": "TomoroAI/tomoro-colqwen3-embed-4b",
        "model_config": {
          "token_pool_factor": 1
        },
        "pipeline_config": {
          "extract_keyframes": true,
          "transcribe_audio": false,
          "generate_descriptions": false,
          "generate_embeddings": true
        },
        "strategies": {
          "segmentation": {
            "class": "ImageSegmentationStrategy",
            "params": {
              "max_images": 10000
            }
          },
          "transcription": {
            "class": "NoTranscriptionStrategy",
            "params": {}
          },
          "description": {
            "class": "NoDescriptionStrategy",
            "params": {}
          },
          "embedding": {
            "class": "MultiVectorEmbeddingStrategy",
            "params": {}
          }
        },
        "embedding_type": "multi_vector",
        "model_loader": "colpali",
        "inference_services": {
          "embedding": "vllm_colpali"
        },
        "schema_config": {
          "schema_name": "image_colpali_mv",
          "model_name": "ColQwen3",
          "num_patches": 1024,
          "embedding_dim": 320,
          "binary_dim": 40
        }
      },
      "audio_clap_semantic": {
        "type": "audio",
        "description": "Audio ingestion with CLAP acoustic embeddings (512-dim) and LateOn semantic embeddings (128-dim multi-vector) from transcripts.",
        "schema_name": "audio_content",
        "result_granularity": "source",
        "embedding_model": "laion/clap-htsat-unfused",
        "pipeline_config": {
          "extract_keyframes": false,
          "transcribe_audio": true,
          "generate_descriptions": false,
          "generate_embeddings": true
        },
        "strategies": {
          "segmentation": {
            "class": "AudioFileSegmentationStrategy",
            "params": {
              "max_files": 10000
            }
          },
          "transcription": {
            "class": "AudioTranscriptionStrategy",
            "params": {
              "model": "openai/whisper-large-v3-turbo"
            }
          },
          "description": {
            "class": "NoDescriptionStrategy",
            "params": {}
          },
          "embedding": {
            "class": "AudioEmbeddingStrategy",
            "params": {}
          }
        },
        "embedding_type": "multi_vector",
        "model_loader": "colbert",
        "inference_services": {
          "embedding": "colbert_pylate",
          "transcription": "vllm_asr",
          "acoustic_embedding": "clap_embed"
        },
        "semantic_model": "lightonai/LateOn",
        "schema_config": {"schema_name": "audio_content", "embedding_dim": 128, "binary_dim": 16}
      },
      "audio_embeddinggemma2": {
        "type": "audio",
        "description": "EmbeddingGemma 2 acoustic embeddings (768-dim), one document per audio window of at most 10 s, in one space with text so a text query retrieves sounds directly. Served by the vllm_omni_embed service.",
        "schema_name": "audio_embeddinggemma2",
        "result_granularity": "source",
        "embedding_model": "google/embeddinggemma-2",
        "pipeline_config": {
          "extract_keyframes": false,
          "transcribe_audio": true,
          "generate_descriptions": false,
          "generate_embeddings": true
        },
        "strategies": {
          "segmentation": {
            "class": "AudioFileSegmentationStrategy",
            "params": {
              "max_files": 10000
            }
          },
          "transcription": {
            "class": "AudioTranscriptionStrategy",
            "params": {
              "model": "openai/whisper-large-v3-turbo"
            }
          },
          "description": {
            "class": "NoDescriptionStrategy",
            "params": {}
          },
          "embedding": {
            "class": "AudioEmbeddingStrategy",
            "params": {}
          }
        },
        "embedding_type": "single_vector",
        "model_loader": "embeddinggemma2",
        "modalities": [
          "audio"
        ],
        "inference_services": {
          "embedding": "vllm_omni_embed",
          "transcription": "vllm_asr",
          "acoustic_embedding": "vllm_omni_embed"
        },
        "schema_config": {
          "schema_name": "audio_embeddinggemma2",
          "model_name": "EmbeddingGemma-2",
          "embedding_dim": 768
        }
      },
      "document_text_semantic": {
        "type": "document",
        "description": "Document text extraction with LateOn multi-vector embeddings (128-dim per token). Supports PDF, TXT, and Markdown files.",
        "schema_name": "document_text",
        "result_granularity": "source",
        "embedding_model": "lightonai/LateOn",
        "pipeline_config": {
          "extract_keyframes": false,
          "transcribe_audio": false,
          "generate_descriptions": false,
          "generate_embeddings": true
        },
        "strategies": {
          "segmentation": {
            "class": "DocumentSegmentationStrategy",
            "params": {
              "max_files": 10000
            }
          },
