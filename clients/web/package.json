{
  "name": "cogniverse-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cogniverse web UI: CopilotKit chat with every registered Cogniverse agent over the runtime's AG-UI surface.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@copilotkit/react-core": "1.77.0",
    "@copilotkit/runtime": "1.77.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.5"
  }
}
